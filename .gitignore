# Local configuration and credentials
.env
.env.*
!.env.example

# Python-generated files
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
~$*

# Local exports and backup artifacts
output/
outputs/
backups/

# Central QMS runtime data (backup separately; never commit)
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal

# Local patch transport files used by Windows sandbox tooling
/*.diff
/*.patch
*.bak
*.zip
