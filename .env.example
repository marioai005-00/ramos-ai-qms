# Copy this file to .env for local configuration.
SYSTEM_NAME=AI-QMS 8D Commander
COMPANY_NAME=RAmos
AI_MODEL_BACKEND=not-configured
SLA_D3_HOURS=24
SLA_D4_DAYS=5
SLA_D8_DAYS=14
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Central QMS authentication and persistence
# Use a server-local absolute path in production; do not place credentials in Google Drive/Git.
QMS_DATABASE_PATH=data/qms.sqlite3
QMS_DEMO_PASSWORD=change-this-before-production

# Governed Agent Runtime and central scheduler
QMS_AGENT_RUNTIME_ENABLED=true
QMS_SCHEDULER_ENABLED=true
QMS_SCHEDULER_INTERVAL_SECONDS=60
QMS_INTERNAL_SYSTEM_PROVIDER=UNCONFIGURED
QMS_EXTERNAL_SYSTEM_WRITE_ENABLED=false

# Internal notification mail (SLA alerts). Customer report dispatch is not sent by the system.
# To switch sending on: QMS_MAIL_PROVIDER=SMTP and QMS_EXTERNAL_SEND_ENABLED=true, then restart the server.
QMS_MAIL_PROVIDER=UNDECIDED
QMS_EXTERNAL_SEND_ENABLED=false
QMS_SMTP_HOST=
QMS_SMTP_PORT=587
# STARTTLS (usually port 587), SSL (usually port 465) or NONE
QMS_SMTP_SECURITY=STARTTLS
QMS_SMTP_USER=
QMS_SMTP_PASSWORD=
QMS_MAIL_FROM=
# While test mode is true every mail goes only to QMS_MAIL_TEST_RECIPIENT.
QMS_MAIL_TEST_MODE=true
QMS_MAIL_TEST_RECIPIENT=sjkim@ramostek.com
# SLA alert levels that send mail: L1_ATTENTION, L2_CRITICAL, L3_OVERDUE (comma separated)
QMS_MAIL_SLA_LEVELS=L1_ATTENTION,L2_CRITICAL,L3_OVERDUE
